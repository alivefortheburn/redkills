* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Helvetica, Arial, sans-serif;
  text-transform: lowercase;
}

html, body {
  height: 100%;
  background: #fff;
  overflow-x: hidden;
}

/* Enter screen */
#enter-screen {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  z-index: 20;
  transition: opacity 1s ease;
}

#enter-btn {
  font-size: 2rem;
  padding: 1rem 2rem;
  border: none;
  background: none;
  cursor: pointer;
  text-transform: lowercase;
}

/* Intro logo (fades in, then out) */
#logo-screen {
  position: fixed;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  opacity: 0;
  z-index: 15;
  transition: opacity 1.5s ease;
  pointer-events: none;
}
#logo-screen img {
  max-width: 300px;
}

/* Persistent header logo */
#site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  padding: 1rem 0;
  background: #fff;
  z-index: 5;
  opacity: 0;
  transition: opacity 1s ease;
}
#site-header img {
  max-width: 80px;
}

/* Gallery */
#gallery {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rem;
  padding: 120px 0 60px;
  opacity: 0;
  transition: opacity 1s ease;
}
.gallery-item {
  max-width: 90%;
  cursor: pointer;
}

/* Detail view — fits in one screen, no scrolling */
#detail-view {
  position: fixed;
  inset: 0;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100px 1rem 2rem;
  opacity: 0;
  pointer-events: none;
  transition: opacity 1s ease;
  z-index: 8;
}
#back-btn {
  position: absolute;
  top: 1rem;
  left: 1rem;
  background: none;
  border: none;
  font-size: 1rem;
  cursor: pointer;
  text-transform: lowercase;
}
#detail-photos {
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  max-width: 90%;
  max-height: 70vh;
}
.detail-photo {
  scroll-snap-align: center;
  max-height: 70vh;
  max-width: 100%;
  object-fit: contain;
  flex-shrink: 0;
}
#detail-description {
  margin-top: 1rem;
  text-align: center;
  text-transform: lowercase;
}

/* Visible states (toggled by JS) */
.visible {
  opacity: 1 !important;
  pointer-events: auto !important;
}
.hidden {
  opacity: 0 !important;
  pointer-events: none !important;
}
